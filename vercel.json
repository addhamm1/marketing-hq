{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/due-soon",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/auto-checkout",
      "schedule": "5 * * * *"
    }
  ]
}
