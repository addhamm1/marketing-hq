# Copy to .env.local for local development. Never commit real values.

# Supabase (local values are printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, used in src/lib/supabase/admin.ts

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Cairo

# Sign-in is email and password only. Public sign-up is disabled in each Supabase project
# (local: supabase/config.toml [auth] enable_signup = false); admins create accounts in /admin/users.

# Vercel: preview deployments use the STAGING Supabase project's URL and keys; production uses PRODUCTION.

# Cron route protection (Vercel Cron sends it as a bearer token)
CRON_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM="Marketing HQ <marketinghq@e-spaces.co>"

# Phone notifications (web push). Generate once with: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://hq.e-spaces.co

# Errors
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
