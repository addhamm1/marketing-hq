    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
