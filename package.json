{
  "name": "pixel-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x imgproxy,supavisor,vector,logflare,mailpit,studio,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "make:placeholders": "tsx scripts/make-placeholders.ts"
  },
  "dependencies": {
